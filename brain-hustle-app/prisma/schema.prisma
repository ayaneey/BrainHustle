generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id       String     @id @map("_id") @db.String   // Clerk's string ID
  email    String     @unique
  name     String?
  todos    ToDo[]
  thoughts Thoughts[]
}

model ToDo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  createdAt DateTime @default(now())
  userId    String   @db.String             // <- ✅ FIX HERE
  user      User     @relation(fields: [userId], references: [id])
}

model Thoughts {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  createdAt DateTime @default(now())
  userId    String   @db.String             // <- ✅ FIX HERE
  user      User     @relation(fields: [userId], references: [id])
}

model QuizResult {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  subject   String
  score     Int
  date      DateTime @default(now())
}


