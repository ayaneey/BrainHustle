generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User { // User model to store user information
  id       String     @id @map("_id") @db.String   // Clerk's string ID
  email    String     @unique
  name     String?
  todos    ToDo[]
  thoughts Thoughts[]
}

model ToDo { // ToDo model to store user tasks
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  createdAt DateTime @default(now())
  userId    String   @db.String             // <- ✅ FIX HERE
  user      User     @relation(fields: [userId], references: [id])
}

model Thoughts { // Thoughts model to store user thoughts
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  createdAt DateTime @default(now())
  userId    String   @db.String             
  user      User     @relation(fields: [userId], references: [id])
}

model QuizResult { // Model to store quiz results
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId   String
  subject  String
  score    Int
  maxScore Int      @default(20)   
  date     DateTime @default(now())
}




